# Cyql API credentials — copy to `.env` (which is git-ignored) and fill in.
#
# Official read-only API key, created in the Cyql dashboard under Settings -> API.
# Sent as the `X-Api-Key` header to https://api.cyql.app/api/graphql.
# NOTE: the variable name keeps the existing "CYCQ" spelling.
CYCQ_API_KEY=your-cyql-api-key-here

# Optional (deferred / writes only): internal-API session bearer token, copied from
# the `token` cookie at dashboard.cyql.app. Unsupported; leave unset for read-only use.
# CYQL_SESSION_TOKEN=
